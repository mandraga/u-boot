CONFIG_UART0_PORT_F=y
CONFIG_BOOTCOMMAND="setenv bootargs root=/dev/mmcblk2p1 rootwait console=ttyS0,115200 fbcon=rotate:3 rw; \
usb start; \
ext4load usb 0:2 0x42000000 boot/zImage; \
ext4load usb 0:1 0x43000000 sun8i-a33-zortrax-m200plus.dtb; \
bootz 0x42000000 - 0x43000000"
#CONFIG_EXTRA_ENV_SETTINGS="fel_mode=mw.l 0x01f00108 0x5aa5a55a 1; reset"
## USB
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_FUNCTION_MASS_STORAGE=y
CONFIG_CMD_USB_MASS_STORAGE=y
CONFIG_USB_MUSB_GADGET=y
# Trade off mass storage and usb host
CONFIG_USB_MUSB_HOST=y
